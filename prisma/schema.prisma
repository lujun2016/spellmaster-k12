generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举 ====================

enum Rank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  STAR
  KING
  SUPREME_KING
  GLORY_KING
  LEGEND_KING
  LEGEND_20_STAR
  LEGEND_40_STAR
}

enum AttemptType {
  PRACTICE
  CHALLENGE
}

// ==================== 教材/词库 ====================

model Textbook {
  id        String   @id @default(cuid())
  name      String
  grades    Grade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id         String   @id @default(cuid())
  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  name       String
  level      Int
  units      Unit[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Unit {
  id            String         @id @default(cuid())
  gradeId       String
  grade         Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int            @default(0)
  words         Word[]
  video         Video?
  lessonRecords LessonRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Word {
  id               String            @id @default(cuid())
  unitId           String
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  en               String
  zh               String
  phonetic         String            @default("")
  sortOrder        Int               @default(0)
  spellingAttempts SpellingAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Video {
  id        String   @id @default(cuid())
  unitId    String   @unique
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  fileKey   String?
  duration  Float?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 用户 ====================

model User {
  id               String            @id @default(cuid())
  username         String            @unique
  passwordHash     String
  name             String
  isAdmin          Boolean           @default(false)
  parentPhone      String?
  parentWechatId   String?
  gradeLevel       Int?
  notes            String?
  avatar           String?           @default("boy1")
  currentRank      Rank              @default(BRONZE)
  rankValue        Int               @default(1)
  rankHistory      RankHistory[]
  lessonRecords    LessonRecord[]
  spellingAttempts SpellingAttempt[]
  unitChallenges   UnitChallenge[]
  learningSessions LearningSession[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ==================== 学习记录 ====================

model LessonRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completedAt  DateTime @default(now())
  totalWords   Int
  correctCount Int
  attemptCount Int      @default(1)
  timeSpent    Int
  isPerfect    Boolean  @default(false)

  @@unique([userId, unitId, attemptCount])
}

model SpellingAttempt {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      String
  word        Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  unitId      String
  attemptType AttemptType @default(PRACTICE)
  userInput   String
  isCorrect   Boolean
  timeSpent   Int         @default(0)
  createdAt   DateTime    @default(now())
}

model UnitChallenge {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId         String
  attemptNum     Int      @default(1)
  totalQuestions Int
  correctCount   Int
  isPerfect      Boolean  @default(false)
  timeSpent      Int
  rankAwarded    Rank?
  questionWords  Json
  createdAt      DateTime @default(now())
}

// ==================== 段位历史 ====================

model RankHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromRank  Rank
  toRank    Rank
  fromValue Int
  toValue   Int
  reason    String
  unitId    String?
  createdAt DateTime @default(now())
}

// ==================== 学习会话 ====================

model LearningSession {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt          DateTime  @default(now())
  endedAt            DateTime?
  wordsPracticed     Int       @default(0)
  wordsWrong         Json?
  challengeCompleted Boolean   @default(false)
  challengeResult    Json?
  totalTimeSpent     Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

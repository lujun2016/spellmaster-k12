.home {
  padding: 24rpx;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.child-info {
  display: flex;
  align-items: center;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: #4f46e5;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 20rpx;
}
.child-name {
  font-size: 34rpx;
  font-weight: 600;
}
.child-grade {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}
.stage {
  margin: 24rpx 0;
}
.state-desc {
  text-align: center;
}
.state-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.state-text {
  font-size: 26rpx;
  color: #6b7280;
}
.summary-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4f46e5, #7c6cf0);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.sb-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.sb-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 8rpx;
}
.sb-arrow {
  color: #fff;
  font-size: 48rpx;
}
.actions {
  display: flex;
  gap: 20rpx;
}
.act {
  flex: 1;
  background: #4f46e5;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.act.ghost {
  background: #fff;
  color: #4f46e5;
  border: 2rpx solid #4f46e5;
}

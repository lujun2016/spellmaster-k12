.summary {
  padding: 24rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}
.row:last-child {
  border-bottom: none;
}
.k {
  color: #6b7280;
  font-size: 28rpx;
}
.v {
  font-size: 28rpx;
  font-weight: 500;
}
.challenge {
  display: flex;
  justify-content: space-between;
  background: #fff7ed;
  color: #c0532b;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.challenge.good {
  background: #ecfdf5;
  color: #047857;
}
.wrong-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}
.wrong-item:last-child {
  border-bottom: none;
}
.wrong-en {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}
.wrong-zh {
  font-size: 28rpx;
  color: #374151;
  margin-top: 6rpx;
}
.ph {
  color: #9ca3af;
  font-size: 24rpx;
}
.wrong-input {
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 6rpx;
}
.empty {
  text-align: center;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.back {
  margin-top: 12rpx;
  background: #4f46e5;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

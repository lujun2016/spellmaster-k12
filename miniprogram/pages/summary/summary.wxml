<view class="summary">
  <block wx:if="{{empty}}">
    <view class="card empty">
      <view class="empty-title">暂无新数据</view>
      <view class="muted">孩子本次尚未结束学习，或汇总已查看。</view>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="row"><text class="k">开始时间</text><text class="v">{{startedAt}}</text></view>
      <view class="row"><text class="k">结束时间</text><text class="v">{{endedAt}}</text></view>
      <view class="row"><text class="k">练习单词</text><text class="v">{{wordsPracticed}} 个</text></view>
      <view class="row"><text class="k">总耗时</text><text class="v">{{totalTime}}</text></view>
    </view>

    <view class="card" wx:if="{{challengeCompleted}}">
      <view class="card-title">单元挑战</view>
      <view class="challenge {{challengeAllRight ? 'good' : ''}}">
        <text>正确率 {{correctRate}}%</text>
        <text>{{correctCount}} / {{totalQuestions}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">错词列表（{{wrongCount}}）</view>
      <view wx:if="{{wrongCount === 0}}" class="muted">本次全部正确，太棒了！</view>
      <view wx:for="{{wrongWords}}" wx:key="en" class="wrong-item">
        <view class="wrong-en">{{item.en}}</view>
        <view class="wrong-zh">{{item.zh}} <text class="ph">{{item.phonetic}}</text></view>
        <view class="wrong-input">你的输入：{{item.userInput}}</view>
      </view>
    </view>
  </block>

  <button class="back" bindtap="goHome">返回首页</button>
</view>

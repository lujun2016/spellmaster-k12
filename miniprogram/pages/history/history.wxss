.history {
  padding: 24rpx;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.item-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}
.tag {
  font-size: 24rpx;
  color: #047857;
  background: #ecfdf5;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.item-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6b7280;
}

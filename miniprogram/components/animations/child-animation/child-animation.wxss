.anim {
  width: 100%;
  min-height: 620rpx;
}
.scene {
  position: relative;
  width: 100%;
  height: 620rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #eef2ff 0%, #f5f6fa 100%);
  overflow: hidden;
}

/* 小孩通用造型 */
.kid {
  position: absolute;
  left: 50%;
  bottom: 120rpx;
  transform: translateX(-50%);
  width: 160rpx;
  height: 240rpx;
}
.kid .head {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffd9a0;
  margin: 0 auto;
  border: 4rpx solid #e0b07a;
}
.kid .body {
  width: 150rpx;
  height: 150rpx;
  border-radius: 40rpx 40rpx 20rpx 20rpx;
  background: #6c8cff;
  margin: 8rpx auto 0;
}
.desk {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  width: 280rpx;
  height: 16rpx;
  background: #c9a06a;
  border-radius: 8rpx;
}
.desk::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 16rpx;
  width: 200rpx;
  height: 60rpx;
  transform: translateX(-50%);
  background: #b98c52;
  border-radius: 0 0 12rpx 12rpx;
}
.caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4b5563;
}

/* 空闲：字母泡泡上升 */
.bubbles {
  position: absolute;
  left: 50%;
  top: 40rpx;
  transform: translateX(-50%);
  width: 320rpx;
  height: 320rpx;
}
.bubble {
  position: absolute;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff;
  color: #4f46e5;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(79, 70, 229, 0.2);
  animation: rise 3s ease-in-out infinite;
}
.b1 { left: 10rpx; animation-delay: 0s; }
.b2 { left: 90rpx; animation-delay: 0.7s; }
.b3 { left: 170rpx; animation-delay: 1.4s; }
.b4 { left: 240rpx; animation-delay: 2.1s; }
@keyframes rise {
  0% { transform: translateY(40rpx) scale(0.8); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translateY(-120rpx) scale(1.1); opacity: 0; }
}

/* 学习：单词从上方涌入 */
.words-in {
  position: absolute;
  left: 0;
  right: 0;
  top: 20rpx;
  height: 200rpx;
}
.words-in .w {
  position: absolute;
  left: 50%;
  font-size: 30rpx;
  color: #4f46e5;
  font-weight: 600;
  background: #fff;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  animation: inflow 2.4s ease-in infinite;
}
.w1 { transform: translateX(-160rpx); animation-delay: 0s; }
.w2 { transform: translateX(-40rpx); animation-delay: 0.6s; }
.w3 { transform: translateX(60rpx); animation-delay: 1.2s; }
.w4 { transform: translateX(150rpx); animation-delay: 1.8s; }
@keyframes inflow {
  0% { top: -40rpx; opacity: 0; }
  40% { opacity: 1; }
  100% { top: 160rpx; opacity: 0; }
}
.icons {
  position: absolute;
  right: 30rpx;
  top: 240rpx;
  width: 160rpx;
}
.icons .ic {
  display: block;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #fff7d6;
  color: #b9770b;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  animation: blink 1.2s ease-in-out infinite;
}
.ic2 { animation-delay: 0.4s; background: #e3f3ff; color: #1f7ab0; }
.ic3 { animation-delay: 0.8s; background: #ffe9e3; color: #c0532b; }
@keyframes blink {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50% { transform: scale(1.12); opacity: 1; }
}

/* 挑战：跑步机 + 计时器 */
.kid.run .band {
  display: none;
}
.band {
  position: absolute;
  top: 0;
  left: 20rpx;
  width: 60rpx;
  height: 20rpx;
  background: #ef4444;
  border-radius: 6rpx;
}
.kid.run .head { border-color: #ef4444; }
.treadmill {
  position: absolute;
  left: 50%;
  bottom: 60rpx;
  transform: translateX(-50%);
  width: 360rpx;
  height: 64rpx;
  background: #374151;
  border-radius: 16rpx;
  overflow: hidden;
}
.belt {
  position: absolute;
  top: 18rpx;
  left: 0;
  white-space: nowrap;
  animation: scrollBelt 2.5s linear infinite;
}
.belt-word {
  display: inline-block;
  color: #fff;
  font-size: 28rpx;
  padding: 0 24rpx;
  font-weight: 600;
}
@keyframes scrollBelt {
  0% { transform: translateX(0); }
  100% { transform: translateX(-360rpx); }
}
.stopwatch {
  position: absolute;
  left: 50%;
  top: 40rpx;
  transform: translateX(-50%);
  min-width: 120rpx;
  text-align: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(239, 68, 68, 0.35);
}

/* 课后：做操 + 小伙伴 */
.kid.exercise {
  animation: exercise 1.6s ease-in-out infinite;
}
@keyframes exercise {
  0%, 100% { transform: translateX(-50%) rotate(-6deg); }
  50% { transform: translateX(-50%) rotate(6deg); }
}
.friends {
  position: absolute;
  bottom: 80rpx;
  width: 100%;
}
.friend {
  position: absolute;
  width: 70rpx;
  height: 110rpx;
  border-radius: 30rpx;
  background: #34d399;
}
.f1 { left: 40rpx; background: #f59e0b; animation: movex 2s ease-in-out infinite; }
.f2 { left: 50%; background: #38bdf8; animation: movey 2.4s ease-in-out infinite; }
.f3 { right: 40rpx; background: #fb7185; animation: movex 2.2s ease-in-out infinite reverse; }
@keyframes movex {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(30rpx); }
}
@keyframes movey {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-30rpx); }
}
.ex-btn {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  transform: translateX(-50%);
  background: #4f46e5;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 14rpx 40rpx;
}
